// TigerGraph DDL Schema for Olympic Games Knowledge Graph
// Graph: OlympicGraph

CREATE VERTEX OlympicGames (
    PRIMARY_ID id STRING,
    name STRING,
    year INT,
    season STRING,
    city STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Sport (
    PRIMARY_ID id STRING,
    name STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Event (
    PRIMARY_ID id STRING,
    name STRING,
    sport STRING,
    gender STRING,
    competitors INT,
    nations INT,
    date STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Athlete (
    PRIMARY_ID id STRING,
    name STRING,
    country STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Venue (
    PRIMARY_ID id STRING,
    name STRING,
    city STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Nation (
    PRIMARY_ID id STRING,
    name STRING,
    code STRING
) WITH STATS="OUTDEGREE";

CREATE VERTEX Document (
    PRIMARY_ID id STRING,
    title STRING,
    url STRING,
    approx_tokens INT
) WITH STATS="OUTDEGREE";

// Edges
CREATE DIRECTED EDGE PART_OF_GAMES (FROM Event, TO OlympicGames) WITH REVERSE_EDGE="REVERSE_PART_OF_GAMES";
CREATE DIRECTED EDGE OF_SPORT (FROM Event, TO Sport) WITH REVERSE_EDGE="REVERSE_OF_SPORT";
CREATE DIRECTED EDGE HELD_AT_VENUE (FROM Event, TO Venue) WITH REVERSE_EDGE="REVERSE_HELD_AT_VENUE";
CREATE DIRECTED EDGE WON_GOLD (FROM Athlete, TO Event) WITH REVERSE_EDGE="REVERSE_WON_GOLD";
CREATE DIRECTED EDGE WON_SILVER (FROM Athlete, TO Event) WITH REVERSE_EDGE="REVERSE_WON_SILVER";
CREATE DIRECTED EDGE WON_BRONZE (FROM Athlete, TO Event) WITH REVERSE_EDGE="REVERSE_WON_BRONZE";
CREATE DIRECTED EDGE REPRESENTS_NATION (FROM Athlete, TO Nation) WITH REVERSE_EDGE="REVERSE_REPRESENTS_NATION";
CREATE DIRECTED EDGE NEXT_EDITION (FROM OlympicGames, TO OlympicGames) WITH REVERSE_EDGE="PREVIOUS_EDITION";
CREATE DIRECTED EDGE HAS_DOCUMENT (FROM Event, TO Document) WITH REVERSE_EDGE="REVERSE_HAS_DOCUMENT";

CREATE GRAPH OlympicGraph (
    OlympicGames, Sport, Event, Athlete, Venue, Nation, Document,
    PART_OF_GAMES, OF_SPORT, HELD_AT_VENUE, WON_GOLD, WON_SILVER, WON_BRONZE,
    REPRESENTS_NATION, NEXT_EDITION, PREVIOUS_EDITION, HAS_DOCUMENT
);