# TigerGraph Agentic GraphRAG Configuration

# TigerGraph Connection Settings (PRIMARY GRAPH BACKEND)
# To use TigerGraph Savanna Cloud (tgcloud.io), fill in your instance URL and credentials:
TIGERGRAPH_HOST=http://127.0.0.1:14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_GRAPH=OlympicGraph
TIGERGRAPH_SECRET=
TIGERGRAPH_TOKEN=
USE_TIGERGRAPH=true

# LLM Provider: 'gemini', 'openai', 'groq', or 'offline'
# If API keys are left blank, the system automatically uses the offline deterministic grounded reasoning engine.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Dense Sentence Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5

# API Server
API_HOST=0.0.0.0
API_PORT=8000